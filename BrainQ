// ---------- save / load ----------
Brain.SaveExists = function()
    return get_shell.host_computer.File(home_dir + "/brain.sav") != null
end function

Brain.Save = function(quiet)
    comp = get_shell.host_computer
    if comp.File(home_dir + "/brain.sav") == null then comp.touch(home_dir, "brain.sav")
    f = comp.File(home_dir + "/brain.sav")
    sickFlag = 0
    if self.sick then sickFlag = 1
    flat = []
    for j in range(0, K - 1)
        flat.push(round(self.hb[j], 3))
    end for
    for j in range(0, K - 1)
        for i in range(0, INW - 1)
            flat.push(round(self.hw[j][i], 3))
        end for
    end for
    q = ""
    if self.quest != null then q = [self.quest["cmd"], self.quest["goal"], self.quest["prog"], self.quest["reward"]].join(":")
    stats = [self.lastCmd, self.mlSteps, self.hits, self.guesses, self.faints, self.gamesPlayed, self.hacks, self.bestHack, self.invented, self.rpsWins, self.rpsLoss, self.bgTotal, self.rpsLast, self.coins, self.xp, self.level, self.gen]
    recs = ["V6"]
    recs.push("name=" + self.name)
    recs.push("curious=" + round(self.curious, 3))
    recs.push("brave=" + round(self.brave, 3))
    recs.push("social=" + round(self.social, 3))
    recs.push("bond=" + round(self.bond, 2))
    recs.push("happy=" + round(self.happy, 3))
    recs.push("hunger=" + round(self.hunger, 2))
    recs.push("energy=" + round(self.energy, 2))
    recs.push("age=" + self.age)
    recs.push("sick=" + sickFlag)
    recs.push("words=" + self.words.join("|"))
    recs.push("equipped=" + self.equipped)
    recs.push("inv=" + dumpMap(self.inv))
    recs.push("ach=" + self.ach.join("|"))
    recs.push("friends=" + dumpMap(self.friends))
    recs.push("quest=" + q)
    recs.push("stats=" + stats.join("|"))
    recs.push("rps=" + self.rpsM.join("|"))
    recs.push("weights=" + flat.join("|"))
    recs.push("sent=" + dumpMap(self.sent))
    recs.push("bg=" + dumpMap(self.bg))
    f.set_content(recs.join("#"))
    if not quiet then print("Saved " + self.name + " (body, mind, items, friends) to " + home_dir + "/brain.sav")
end function

Brain.Load = function()
    f = get_shell.host_computer.File(home_dir + "/brain.sav")
    if f == null then return false
    recs = f.get_content.split("#")
    if recs[0] != "V6" then return false
    d = {}
    for i in range(1, recs.len - 1)
        r = recs[i]
        pos = r.indexOf("=")
        if pos != null then d[r[:pos]] = r[pos + 1:]
    end for
    self.name = getStr(d, "name", self.name)
    self.curious = getNum(d, "curious", 0.5)
    self.brave = getNum(d, "brave", 0.5)
    self.social = getNum(d, "social", 0.5)
    self.bond = getNum(d, "bond", 10)
    self.happy = getNum(d, "happy", 0.5)
    self.hunger = getNum(d, "hunger", 0)
    self.energy = getNum(d, "energy", 100)
    self.age = getNum(d, "age", 0)
    self.sick = (getNum(d, "sick", 0) == 1)
    self.words = getList(d, "words")
    self.equipped = getStr(d, "equipped", "")
    self.inv = parseMap(getStr(d, "inv", ""))
    self.ach = getList(d, "ach")
    self.friends = parseMap(getStr(d, "friends", ""))
    self.sent = parseMap(getStr(d, "sent", ""))
    self.bg = parseMap(getStr(d, "bg", ""))
    qs = getStr(d, "quest", "")
    self.quest = null
    if qs != "" then
        qp = qs.split(":")
        if qp.len == 4 then self.quest = {"cmd": qp[0], "goal": qp[1].val, "prog": qp[2].val, "reward": qp[3].val}
    end if
    st = getList(d, "stats")
    if st.len >= 17 then
        self.lastCmd = st[0].val
        self.mlSteps = st[1].val
        self.hits = st[2].val
        self.guesses = st[3].val
        self.faints = st[4].val
        self.gamesPlayed = st[5].val
        self.hacks = st[6].val
        self.bestHack = st[7].val
        self.invented = st[8].val
        self.rpsWins = st[9].val
        self.rpsLoss = st[10].val
        self.bgTotal = st[11].val
        self.rpsLast = st[12].val
        self.coins = st[13].val
        self.xp = st[14].val
        self.level = st[15].val
        self.gen = st[16].val
    end if
    rp = getList(d, "rps")
    if rp.len == 9 then
        for i in range(0, 8)
            self.rpsM[i] = rp[i].val
        end for
    end if
    flat = getList(d, "weights")
    if flat.len == K + K * INW then
        idx = 0
        for j in range(0, K - 1)
            self.hb[j] = flat[idx].val
            idx = idx + 1
        end for
        for j in range(0, K - 1)
            for i in range(0, INW - 1)
                self.hw[j][i] = flat[idx].val
                idx = idx + 1
            end for
        end for
    end if
    self.stageName = self.Stage()
    self.lastTime = time
    return true
end function

// ---------- birth ----------
Brain.Hatch = function(inherited)
    print("An egg made of random letters appears...")
    for i in range(1, 4)
        print("   " + randomWord(10, alphabet))
        pause(0.4)
    end for
    print("...crack!...")
    pause(0.6)
    print("<color=#ffff44>" + self.name + " is born!</color>")
    print("curious " + self.Bar(self.curious * 100) + "  brave " + self.Bar(self.brave * 100) + "  social " + self.Bar(self.social * 100))
    if inherited then
        print("It inherited a faint memory of its parent's mind. (generation " + self.gen + ")")
    else
        print("Its ML mind is empty. It will learn your habits, your words and your letters.")
        print("You start with 20 coins and 2 apples. Type 'quest' for your first job.")
    end if
    self.Beat(3)
end function

// ===== Train the XOR core =====
brain = Brain.New()
data = [[0,0], [0,1], [1,0], [1,1]]
answers = [0, 1, 1, 0]

rawPrint("Growing a brain...")
for epoch in range(1, 10000)
    for i in range(0, 3)
        brain.Learn(data[i], answers[i], 0.8)
    end for
end for

ans = ""
if brain.SaveExists() then ans = user_input("A saved brain was found. Wake it up? (y/n) ").lower
loaded = false
if ans == "y" then loaded = brain.Load()
UI.name = brain.name
clear_screen()
UI.Header(brain)
if ans == "y" and not loaded then print("(that save is from an older version and cannot be loaded, hatching a new one)")
if loaded then
    print(brain.name + " opens its eyes. It remembers you.")
    brain.Beat(2)
else
    brain.NewQuest()
    brain.Hatch(false)
end if
if brain.quest == null then brain.NewQuest()
brain.lastTime = time
print("Type 'help' for commands. Anything else you type, " + brain.name + " will hear.")

// ===== Main loop =====
while true
    now = time
    if now - brain.lastTime > 20 then brain.Away(now - brain.lastTime)

    UI.name = brain.name
    brain.Anticipate()
    UI.Hud(brain)
    cmd = user_input(UI.Prompt()).lower
    if cmd != "" then UI.Echo(cmd)
    parts = cmd.split(" ")
    c = parts[0]
    tickAfter = true
    used = ""
    if cmds.indexOf(c) != null then used = c

    if c == "quit" then
        brain.Save(false)
        print("Goodbye. " + brain.name + " waves a tiny pixel hand.")
        exit
    end if

    if c == "help" then
        print("CARE    : feed | pet | praise | scold | scare | heal | sleep")
        print("TALK    : talk | say <text> | sing | greet | recall | rename <name>")
        print("GAMES   : play | rps | memory | scramble | hack")
        print("SHOP    : shop | buy <item> | inv | use <item> | wear <item>")
        print("INFO    : status | mind | diary | quest | ach | weather | friends")
        print("WATCH   : beat | monitor | live")
        print("LOOK    : theme <night|matrix|sunset|ice> | style <bubbles|simple> | typing | cls | gfx")
        print("OTHER   : learn <word> | legacy | fast | save | quit")
        tickAfter = false
    else if c == "talk" then
        for i in range(1, 3)
            brain.Speak()
        end for
        brain.Quest("talk")
    else if c == "say" and cmd.len > 4 then
        brain.Hear(cmd[4:])
        brain.Quest("say")
    else if c == "sing" then
        brain.Sing()
        brain.Quest("sing")
    else if c == "greet" then
        brain.Greet()
    else if c == "rename" and parts.len > 1 then
        if isWord(parts[1]) and parts[1].len <= 10 then
            brain.name = parts[1][0].upper + parts[1][1:]
            UI.name = brain.name
            print("It will now answer to " + brain.name + ".")
        else
            print("Letters a-z only, up to 10 long.")
        end if
        tickAfter = false
    else if c == "beat" then
        brain.Beat(4)
    else if c == "monitor" then
        brain.Beat(10)
    else if c == "live" then
        brain.Live(15)
        tickAfter = false
    else if c == "status" then
        brain.Status()
        tickAfter = false
    else if c == "mind" then
        brain.Mind()
        tickAfter = false
    else if c == "diary" then
        brain.Diary()
        tickAfter = false
    else if c == "quest" then
        print("Quest: " + brain.QuestText())
        tickAfter = false
    else if c == "ach" then
        brain.Achievements()
        tickAfter = false
    else if c == "weather" then
        brain.ShowWeather()
        tickAfter = false
    else if c == "friends" then
        brain.Friends()
        tickAfter = false
    else if c == "shop" then
        brain.Shop()
        tickAfter = false
    else if c == "inv" then
        brain.Inventory()
        tickAfter = false
    else if c == "buy" and parts.len > 1 then
        brain.Buy(parts[1])
        tickAfter = false
    else if (c == "use" or c == "wear") and parts.len > 1 then
        brain.Use(parts[1])
    else if c == "theme" then
        if parts.len > 1 and UI.themes.hasIndex(parts[1]) then
            UI.t = UI.themes[parts[1]]
            print("Theme set to " + parts[1] + ".")
        else
            print("Themes: " + UI.themes.indexes.join(" "))
        end if
        tickAfter = false
    else if c == "style" then
        if parts.len > 1 and (parts[1] == "bubbles" or parts[1] == "simple") then
            UI.mode = parts[1]
            print("Style: " + parts[1])
        else
            print("style bubbles | style simple")
        end if
        tickAfter = false
    else if c == "typing" then
        UI.typing = not UI.typing
        print("Typing indicator: " + UI.typing)
        tickAfter = false
    else if c == "cls" then
        UI.Redraw(brain)
        tickAfter = false
    else if c == "gfx" then
        UI.on = not UI.on
        rawPrint("Graphics: " + UI.on)
        tickAfter = false
    else if c == "fast" then
        if speedMul == 1 then
            globals.speedMul = 0.15
            print("Fast mode ON (animations are quicker).")
        else
            globals.speedMul = 1
            print("Fast mode OFF.")
        end if
        tickAfter = false
    else if c == "save" then
        brain.Save(false)
        tickAfter = false
    else if c == "legacy" then
        brain.Legacy()
        tickAfter = false
    else if c == "pet" then
        brain.happy = clamp(brain.happy + 0.2, 0, 1)
        brain.stress = clamp(brain.stress - 0.3, 0, 1)
        brain.bond = clamp(brain.bond + 4, 0, 100)
        brain.boredom = clamp(brain.boredom - 10, 0, 100)
        print(brain.Tag() + " purrs in binary. *beep boop*")
        brain.TrainFeel(1)
        brain.Quest("pet")
    else if c == "praise" then
        brain.happy = clamp(brain.happy + 0.1, 0, 1)
        brain.bond = clamp(brain.bond + 2, 0, 100)
        print(brain.name + " glows with pride.")
        brain.TrainFeel(1)
    else if c == "scold" then
        brain.stress = clamp(brain.stress + 0.3, 0, 1)
        brain.happy = clamp(brain.happy - 0.1, 0, 1)
        brain.bond = clamp(brain.bond - 1, 0, 100)
        print(brain.name + " droops sadly.")
        brain.TrainFeel(0)
    else if c == "scare" then
        brain.stress = clamp(brain.stress + 0.9 - brain.brave * 0.4, 0, 1)
        brain.happy = clamp(brain.happy - 0.2, 0, 1)
        brain.bond = clamp(brain.bond - 3, 0, 100)
        print("BOO! The heart jumps!")
        brain.TrainFeel(0)
    else if c == "feed" then
        brain.hunger = clamp(brain.hunger - 30, 0, 100)
        brain.energy = clamp(brain.energy + 20, 0, 100)
        brain.happy = clamp(brain.happy + 0.08, 0, 1)
        print("Nom nom. " + brain.name + " munches happily. (items from the shop are better!)")
        brain.Quest("feed")
    else if c == "play" then
        brain.Play()
        brain.TrainFeel(1)
        brain.Quest("play")
    else if c == "rps" then
        brain.RPS()
    else if c == "memory" then
        brain.Memory()
    else if c == "scramble" then
        brain.Scramble()
    else if c == "hack" then
        brain.Hack()
    else if c == "heal" then
        brain.Heal()
    else if c == "sleep" then
        brain.Sleep()
        brain.Quest("sleep")
    else if c == "recall" then
        brain.Recall()
    else if c == "learn" and parts.len > 1 then
        word = parts[1]
        if isWord(word) and word.len <= 12 then
            brain.Evolve(word)
            brain.Quest("learn")
        else
            print("Letters a-z only, up to 12 long.")
        end if
    else
        brain.Hear(cmd)
        brain.Quest("say")
        used = "say"
    end if

    if used != "" then brain.Observe(cmds.indexOf(used))
    brain.CheckAch()
    if tickAfter then brain.Tick(false)
    if tickAfter and brain.age % 25 == 0 then brain.Save(true)
    brain.lastTime = time
end while
