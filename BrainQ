// ---------- mood and face ----------
Brain.Mood = function()
    a = 0
    if self.bpm > 85 then a = 1
    b = 0
    if self.energy < 50 then b = 1
    unsettled = self.Think([a, b])
    m = self.happy * 0.5 + unsettled * 0.5 + (rnd * 0.2 - 0.1)
    m = m - self.hunger * 0.002
    if self.sick then m = m - 0.2
    if self.weather == "sunny" then m = m + 0.05
    if self.weather == "stormy" then m = m - 0.05
    return clamp(m, 0, 1)
end function

Brain.MoodName = function(m)
    if m < 0.2 then return "gloomy"
    if m < 0.4 then return "calm"
    if m < 0.6 then return "curious"
    if m < 0.8 then return "happy"
    return "excited"
end function

Brain.Face = function(mood)
    if self.sleeping then return "(-_-)zzz"
    if self.sick then return "(x_x)"
    if self.bpm > 110 then return "(O_O)"
    if rnd < 0.1 then return "(-_-)"
    if mood < 0.2 then return "(;_;)"
    if mood < 0.4 then return "(._.)"
    if mood < 0.6 then return "(o_o)"
    if mood < 0.8 then return "(^_^)"
