Brain.RPS = function()
    if self.energy < 10 then
        print(self.name + " is too tired.")
        return
    end if
    names = ["rock", "paper", "scissors"]
    keys = ["r", "p", "s"]
    print(self.name + " challenges you to rock-paper-scissors (5 rounds)!")
    print("<color=#aaaaff>(it is learning which move you throw after which)</color>")
    you = 0
    me = 0
    for rd in range(1, 5)
        g = user_input("r / p / s > ").lower
        y = keys.indexOf(g)
        if y == null then
            print("(skipped)")
            continue
        end if
        pred = floor(rnd * 3)
        if self.rpsLast >= 0 then
            base = self.rpsLast * 3
            best = 0
            for j in range(1, 2)
                if self.rpsM[base + j] > self.rpsM[base + best] then best = j
            end for
            if self.rpsM[base + best] > 0 then pred = best
        end if
        b = (pred + 1) % 3
        if self.rpsLast >= 0 then self.rpsM[self.rpsLast * 3 + y] = self.rpsM[self.rpsLast * 3 + y] + 1
        self.rpsLast = y
        line = "you: " + names[y] + "   " + self.name + ": " + names[b]
        if y == b then
            print(line + "   (tie)")
        else if y == (b + 1) % 3 then
            print(line + "   <color=#44ff44>you win this round</color>")
            you = you + 1
            self.rpsWins = self.rpsWins + 1
        else
            print(line + "   <color=#ff8844>" + self.name + " wins this round</color>")
            me = me + 1
            self.rpsLoss = self.rpsLoss + 1
        end if
    end for
    print("Final score  you " + you + " : " + me + " " + self.name)
    if you > me then
        self.happy = clamp(self.happy - 0.05, 0, 1)
        self.GameDone(15, 10)
    else if you == me then
        self.GameDone(6, 6)
    else
        self.happy = clamp(self.happy + 0.15, 0, 1)
        print(self.name + " does a victory dance!")
        self.GameDone(3, 6)
    end if
end function

Brain.Memory = function()
    n = 3 + clamp(floor(self.level / 2), 0, 5)
    seq = randomWord(n, "abcdefgh")
    print(self.name + " shows you a secret code. Memorize it!")
    print("<color=#ffff44>      " + seq + "</color>")
    wait(1 + n * 0.5)
    clear_screen()
    g = user_input("what was the code? ").lower
    if g == seq then
        print("Perfect memory! The code was " + seq)
        self.GameDone(10 + n, 10)
    else
        print("Nope. It was " + seq)
        self.GameDone(2, 3)
    end if
end function

Brain.Scramble = function()
    if self.words.len == 0 then
        print(self.name + " does not know any words yet. Teach it with 'learn <word>'.")
        return
    end if
    w = self.words[floor(rnd * self.words.len)]
    s = scrambleWord(w)
    tries = 3
    won = false
    while tries > 0
        g = user_input("unscramble '" + s + "' (" + tries + " tries, starts with " + w[0] + "): ").lower
        if g == w then
            won = true
            break
        end if
        tries = tries - 1
    end while
    if won then
        print(self.name + " cheers! (^o^)")
        self.GameDone(6 + tries * 2, 8)
    else
        print("It was '" + w + "'.")
        self.GameDone(1, 3)
    end if
end function

// "hack" a firewall: the brain evolves the password with random letters
Brain.Hack = function()
    if self.energy < 15 then
        print(self.name + " is too tired to hack. Feed it or let it sleep.")
        return
    end if
    size = 3 + clamp(floor(self.level / 3), 0, 3)
    pw = randomWord(size, alphabet)
    print("<color=#ff8844>Target: firewall 10.0." + floor(rnd * 255) + "." + floor(rnd * 255) + "  (" + size + "-letter password)</color>")
    print(self.name + " starts cracking...")
    cur = randomWord(size, alphabet)
    g = 0
    traced = false
    while cur != pw
        g = g + 1
        nxt = ""
        for i in range(0, size - 1)
            if cur[i] == pw[i] then
                nxt = nxt + cur[i]
            else
                nxt = nxt + randLetter(alphabet)
            end if
        end for
        cur = nxt
        print("  try " + g + ": " + cur)
        pause(0.08)
        if g == 15 and rnd < 0.3 then
            print("<color=#ff4444>!! TRACE DETECTED !!</color>")
            self.stress = clamp(self.stress + 0.5, 0, 1)
            self.bpm = clamp(self.bpm + 20, 40, 200)
            traced = true
        end if
    end while
    print("<color=#44ff44>ACCESS GRANTED in " + g + " tries!</color>")
    self.hacks = self.hacks + 1
    if self.bestHack == 0 or g < self.bestHack then
        self.bestHack = g
        print("(new personal best!)")
    end if
    reward = clamp(90 - g, 8, 60) + self.level
    if traced then reward = floor(reward / 2)
    self.energy = clamp(self.energy - 7, 0, 100)
    self.stress = clamp(self.stress + 0.15, 0, 1)
    self.Note("cracked a firewall in " + g + " tries")
    self.GameDone(reward, 14)
end function

