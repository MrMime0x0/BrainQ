// ---------- hearing ----------
Brain.Hear = function(text)
    mood = self.Mood()
    heardWords = []
    for w in text.split(" ")
        if isWord(w) and heardWords.indexOf(w) == null then heardWords.push(w)
    end for
    self.lastHeard = heardWords
    self.boredom = clamp(self.boredom - 15, 0, 100)
    self.bond = clamp(self.bond + 1 + self.social * 2, 0, 100)
    for w in heardWords
        self.LearnLetters(w)
    end for
    p = self.Feel(heardWords)
    d = p - 0.5
    self.happy = clamp(self.happy + d * 0.4, 0, 1)
    if d < 0 then self.stress = clamp(self.stress - d * 1.6, 0, 1)
    print(self.Tag() + " " + self.Face(mood) + " listens... " + self.Babble(mood))
    known = false
    for w in heardWords
        if self.sent.hasIndex(w) then known = true
    end for
    if not known then
        print("<color=#aaaaff>(" + self.name + " does not know these words yet. Use pet/praise or scare/scold to teach it.)</color>")
    else if p > 0.6 then
        print("<color=#44ff44>(feels warm about that: " + round(p * 100) + "%)</color>")
    else if p < 0.4 then
        print("<color=#ff8844>(feels uneasy about that: " + round(p * 100) + "%)</color>")
    else
        print("(unsure how to feel: " + round(p * 100) + "%)")
    end if
    newWord = null
    for w in heardWords
        if newWord == null and w.len >= 3 and w.len <= 8 and self.words.indexOf(w) == null and rnd < 0.2 + self.curious * 0.6 then
            newWord = w
        end if
    end for
    if newWord != null then
        print(self.name + " tries to repeat it: " + self.Garble(newWord, 0.4))
        self.words.push(newWord)
        print("<color=#44ff44>" + self.name + " picked up a new word!</color>")
        self.Note("picked up the word '" + newWord + "'")
        self.happy = clamp(self.happy + 0.1, 0, 1)
        self.Gain(5)
    end if
end function

// ---------- learning words ----------
Brain.Evolve = function(target)
    current = randomWord(target.len, alphabet)
    gen = 0
    print("gen " + gen + ": " + current)
    while current != target
        gen = gen + 1
        nxt = ""
        for i in range(0, target.len - 1)
            if current[i] == target[i] then
                nxt = nxt + current[i]
            else
                nxt = nxt + randLetter(alphabet)
            end if
        end for
        current = nxt
        print("gen " + gen + ": " + current)
        self.stress = clamp(self.stress + 0.02, 0, 1)
        self.bpm = clamp(self.bpm + 1, 40, 200)
    end while
    print(self.name + " learned '" + target + "' in " + gen + " generations!")
    if self.words.indexOf(target) == null then self.words.push(target)
    self.LearnLetters(target)
    self.Note("learned '" + target + "'")
    self.energy = clamp(self.energy - 10, 0, 100)
    self.happy = clamp(self.happy + 0.15, 0, 1)
    self.Gain(10)
end function

Brain.Recall = function()
    if self.words.len == 0 then
        print("(nothing learned yet. try: learn hack)")
        return
    end if
    w = self.words[floor(rnd * self.words.len)]
    fog = (100 - self.energy) / 200
    if self.sick then fog = fog + 0.15
    print(self.name + " remembers... " + self.Garble(w, fog))
end function

// ---------- sleep ----------
Brain.Sleep = function()
    self.sleeping = true
    self.bpm = 55
    wasNight = (self.Phase() == "night")
    print(self.Tag() + " " + self.Face(0.5) + " closes its eyes...")
    while self.energy < 100
        self.energy = clamp(self.energy + 20, 0, 100)
        self.hunger = clamp(self.hunger + 4, 0, 100)
        self.age = self.age + 1
        dream = randomWord(4 + floor(rnd * 6), alphabet)
        if self.bgTotal > 30 and rnd < 0.5 then dream = self.BigramWord(8)
        if self.words.len > 0 and rnd < 0.5 then
            dream = dream + " " + self.Garble(self.words[floor(rnd * self.words.len)], 0.3)
        end if
        if self.stress > 0.3 or rnd < 0.15 then
            self.bpm = clamp(self.bpm + 25, 40, 200)
            print("<color=#ff4444>~ NIGHTMARE: " + dream.upper + " ~</color>  " + round(self.bpm) + " bpm")
        else
            print("<color=#8888ff>~ dreaming: " + dream + " ~</color>  " + round(55 + rnd * 3) + " bpm")
        end if
        if self.bgTotal > 40 and rnd < 0.3 then
            inv = self.BigramWord(7)
            if inv.len >= 3 and self.words.indexOf(inv) == null then
                self.words.push(inv)
                self.invented = self.invented + 1
                print("<color=#44ff44>   " + self.name + " invented a new word in its sleep: " + inv + "</color>")
                self.Note("invented the word '" + inv + "' in a dream")
            end if
        end if
        pause(0.6)
    end while
    self.sleeping = false
    self.bpm = 60
    self.stress = 0
    self.happy = clamp(self.happy + 0.1, 0, 1)
    if wasNight then
        self.happy = clamp(self.happy + 0.1, 0, 1)
        print("(a good night's sleep!)")
    end if
    self.CheckStage()
    print(self.name + " wakes up refreshed.")
end function

