// ---------- ML 1: HABIT PREDICTOR ----------
Brain.BuildInput = function()
    x = []
    for i in range(0, K - 1)
        x.push(0)
    end for
    if self.lastCmd >= 0 then x[self.lastCmd] = 1
    x.push(self.hunger / 100)
    x.push(self.boredom / 100)
    x.push((100 - self.energy) / 100)
    if self.sick then
        x.push(1)
    else
        x.push(0)
    end if
    return x
end function

Brain.Predict = function()
    x = self.BuildInput()
    z = []
    top = -999
    for j in range(0, K - 1)
        s = self.hb[j]
        for i in range(0, x.len - 1)
            s = s + self.hw[j][i] * x[i]
        end for
        z.push(s)
        if s > top then top = s
    end for
    total = 0
    p = []
    for j in range(0, K - 1)
        e = 2.718281828 ^ (z[j] - top)
        p.push(e)
        total = total + e
    end for
    for j in range(0, K - 1)
        p[j] = p[j] / total
    end for
    self.lastX = x
    self.lastP = p
    return p
end function

Brain.Anticipate = function()
    p = self.Predict()
    best = 0
    for j in range(1, K - 1)
        if p[j] > p[best] then best = j
    end for
    self.guess = best
    self.guessConf = p[best]
    if self.mlSteps >= 8 and p[best] > 0.4 then
        print("<color=#aaaaff>(" + self.name + " expects you to '" + cmds[best] + "' - " + round(p[best] * 100) + "% sure)</color>")
    end if
end function

Brain.Observe = function(actual)
    if self.mlSteps >= 8 and self.guessConf > 0.4 then
        self.guesses = self.guesses + 1
        if self.guess == actual then
            self.hits = self.hits + 1
            self.bond = clamp(self.bond + 1, 0, 100)
            print("<color=#44ff44>" + self.name + " guessed you right! (^o^)</color>")
        end if
    end if
    lr = 0.4
    for j in range(0, K - 1)
        target = 0
        if j == actual then target = 1
        err = target - self.lastP[j]
        self.hb[j] = self.hb[j] + lr * err
        for i in range(0, self.lastX.len - 1)
            self.hw[j][i] = self.hw[j][i] + lr * err * self.lastX[i]
        end for
    end for
    self.lastCmd = actual
    self.mlSteps = self.mlSteps + 1
end function

// ---------- ML 2: WORD FEELINGS ----------
Brain.Feel = function(ws)
    z = 0
    for w in ws
        if self.sent.hasIndex(w) then z = z + self.sent[w]
    end for
    return sigmoid(z)
end function

Brain.TrainFeel = function(label)
    if self.lastHeard.len == 0 then return
    p = self.Feel(self.lastHeard)
    err = label - p
    for w in self.lastHeard
        if not self.sent.hasIndex(w) then self.sent[w] = 0
        self.sent[w] = self.sent[w] + 1.5 * err
    end for
    print("<color=#aaaaff>(" + self.name + " updates how it feels about: " + self.lastHeard.join(" ") + ")</color>")
    self.lastHeard = []
end function

// ---------- ML 3: LETTER PATTERNS ----------
Brain.LearnLetters = function(w)
    prev = "^"
    for ch in w
        bump(self.bg, prev + ch, 1)
        prev = ch
    end for
    bump(self.bg, prev + "$", 1)
    self.bgTotal = self.bgTotal + w.len + 1
end function

Brain.BigramWord = function(maxLen)
    out = ""
    prev = "^"
    pool = alphabet + "$"
    while out.len < maxLen
        ws = []
        total = 0
        for ch in pool
            wgt = 0.05
            k = prev + ch
            if self.bg.hasIndex(k) then wgt = wgt + self.bg[k]
            ws.push(wgt)
            total = total + wgt
        end for
        r = rnd * total
        chosen = "$"
        acc = 0
        for i in range(0, pool.len - 1)
            acc = acc + ws[i]
            if r <= acc then
                chosen = pool[i]
                break
            end if
        end for
        if chosen == "$" then break
        out = out + chosen
        prev = chosen
    end while
    if out.len < 2 then out = out + randLetter(vowels)
    return out
end function

