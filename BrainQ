        self.inv[item] = self.inv[item] - 1
        self.curious = clamp(self.curious + 0.05, 0, 1)
        print(self.name + " flips through the book, looking clever.")
        self.Gain(15)
    else
        if self.equipped == item then
            self.equipped = ""
            print(self.name + " takes off the " + item + ".")
        else
            self.equipped = item
            print(self.name + " puts on the " + item + ". Stylish!")
            self.happy = clamp(self.happy + 0.1, 0, 1)
        end if
    end if
end function

// ---------- world: weather, visitors ----------
Brain.WeatherTick = function(silent)
    self.wTicks = self.wTicks - 1
    if self.wTicks <= 0 then
        opts = ["sunny", "sunny", "cloudy", "rainy", "stormy", "snowy"]
        self.weather = opts[floor(rnd * opts.len)]
        self.wTicks = 8 + floor(rnd * 8)
        if not silent then print("<color=#88ccff>The weather turns " + self.weather + ".</color>")
    end if
    if self.weather == "sunny" then self.happy = clamp(self.happy + 0.01, 0, 1)
    if self.weather == "rainy" then self.boredom = clamp(self.boredom + 2, 0, 100)
    if self.weather == "snowy" then self.hunger = clamp(self.hunger + 1, 0, 100)
    if self.weather == "stormy" and self.brave < 0.6 and rnd < 0.3 then
        print(self.name + " flinches at the thunder!")
        self.stress = clamp(self.stress + 0.4, 0, 1)
    end if
end function

Brain.ShowWeather = function()
    print("It is day " + self.Day() + ", " + self.Hour() + ":00 (" + self.Phase() + "), weather: " + self.weather)
end function

Brain.Visit = function()
    if self.visitor != null then return
    if rnd > 0.06 then return
    self.visitor = {"name": makeName(), "ttl": 4, "word": randomWord(4 + floor(rnd * 3), alphabet)}
    print("<color=#ffaa44>A wild " + self.visitor["name"] + " appears and stares at " + self.name + "! (type 'greet')</color>")
end function

Brain.Greet = function()
    if self.visitor == null then
        print("There is nobody here to greet.")
        return
    end if
    v = self.visitor
    delta = 1 + floor(self.social * 3)
    bump(self.friends, v["name"], delta)
    print(self.Tag() + " waves at " + v["name"] + " and babbles: " + self.Babble(0.8))
    print(v["name"] + " answers: " + self.Garble(v["word"], 0.2))
    if self.words.indexOf(v["word"]) == null and rnd < 0.5 + self.curious * 0.4 then
        self.words.push(v["word"])
        self.LearnLetters(v["word"])
        print("<color=#44ff44>" + self.name + " learned '" + v["word"] + "' from its new friend!</color>")
        self.Note("learned '" + v["word"] + "' from " + v["name"])
    end if
    self.happy = clamp(self.happy + 0.15, 0, 1)
    self.boredom = clamp(self.boredom - 25, 0, 100)
    self.Note("befriended " + v["name"])
    self.Gain(8)
    self.visitor = null
end function

Brain.Friends = function()
    if self.friends.len == 0 then
        print("No friends yet. Visitors show up now and then. Type 'greet' when one arrives.")
        return
    end if
    print("--- " + self.name + "'s friends ---")
    for k in self.friends.indexes
        print("  " + k + "  " + ("<3 " * self.friends[k]))
    end for
end function

// ---------- events ----------
Brain.Event = function()
    r = rnd
    ph = self.Phase()
    if self.sick and r < 0.5 then
        print(self.name + " coughs. *cough* *cough*")
    else if self.hunger > 70 and r < 0.5 then
        print("*grrrowl* " + self.name + "'s tummy rumbles.")
    else if self.energy < 20 and r < 0.5 then
        print(self.name + " yawns... " + randomWord(3, "zu"))
    else if self.boredom > 70 and r < 0.5 then
        print(self.name + " stares at you and babbles: " + self.Babble(0.4))
    else if ph == "night" and r < 0.2 then
        print(self.name + " gazes at the stars... " + randomWord(3, "oau") + "...")
    else if self.weather == "rainy" and r < 0.2 then
        print(self.name + " watches the raindrops: " + randomWord(4, alphabet))
    else if self.weather == "sunny" and r < 0.15 then
        print(self.name + " basks in the sunshine. (^_^)")
    else if r < 0.10 then
        print(self.name + " thinks: <color=#aaaaff>" + randomWord(3 + floor(rnd * 5), alphabet) + "...</color>")
    else if r < 0.17 then
        print(self.name + " hiccups. *hic!*")
        self.bpm = clamp(self.bpm + 8, 40, 200)
    else if r < 0.23 then
        print(self.name + " blinks slowly.")
    else if r < 0.28 and self.words.len > 0 then
        print(self.name + " mutters to itself: " + self.Garble(self.words[floor(rnd * self.words.len)], 0.2))
    else if r < 0.32 and self.brave > 0.5 then
        print(self.name + " bravely explores the terminal.")
        self.boredom = clamp(self.boredom - 10, 0, 100)
        if rnd < 0.3 then
            found = 1 + floor(rnd * 4)
            self.coins = self.coins + found
            print("<color=#ffff44>...and finds " + found + " coins!</color>")
        end if
    end if
    self.Visit()
end function

// ---------- tick ----------
Brain.Tick = function(silent)
    self.age = self.age + 1
    self.CheckStage()
    self.energy = clamp(self.energy - 2, 0, 100)
    if self.Phase() == "night" then self.energy = clamp(self.energy - 1, 0, 100)
    self.hunger = clamp(self.hunger + 3, 0, 100)
    self.boredom = clamp(self.boredom + 4 - self.curious * 2, 0, 100)
    self.happy = self.happy + (0.5 - self.happy) * 0.05
    if self.hunger > 80 then self.happy = clamp(self.happy - 0.05, 0, 1)
    if self.boredom > 80 then self.bond = clamp(self.bond - 1, 0, 100)
    if self.sick then self.happy = clamp(self.happy - 0.03, 0, 1)
    if not self.sick and (self.hunger > 90 or self.stress > 0.9) and rnd < 0.3 then
        self.sick = true
        print("<color=#ffaa00>" + self.name + " is not feeling well... (try 'heal' or 'use medicine')</color>")
        self.Note("fell sick")
    end if
    self.WeatherTick(silent)
    if self.visitor != null then
        self.visitor["ttl"] = self.visitor["ttl"] - 1
        if self.visitor["ttl"] <= 0 then
            print(self.visitor["name"] + " wanders away.")
            self.visitor = null
        end if
    end if
    self.UpdateHeart()
    if not silent then self.Event()
end function

Brain.Away = function(dt)
    n = floor(dt / 20)
    if n > 15 then n = 15
    for i in range(1, n)
        self.Tick(true)
    end for
    print("<color=#aaaaaa>(" + round(dt) + "s passed while you were away...)</color>")
    if self.hunger > 70 then print(self.name + " got hungry waiting for you.")
    if self.boredom > 70 then print(self.name + " got bored and lonely.")
    if self.energy < 30 then print(self.name + " is sleepy.")
    mood = self.Mood()
    if self.bond > 50 then
        print(self.Tag() + " " + self.Face(mood) + " lights up: " + self.Babble(0.9) + " <3")
    else
        print(self.Tag() + " " + self.Face(mood) + " glances at you: " + self.Babble(mood))
    end if
    self.Note("waited alone for " + round(dt) + "s")
end function

Brain.Live = function(moments)
    print("Watching " + self.name + " live for " + moments + " moments...")
    breath = ["in ", "out"]
    for i in range(1, moments)
        self.Tick(false)
        print(self.Face(self.Mood()) + " breathe " + breath[i % 2] + " " + self.Pulse() + " " + round(self.bpm) + " bpm")
        pause(60 / self.bpm + 0.5)
    end for
end function

Brain.Heal = function()
    if not self.sick then
        print(self.name + " is perfectly healthy.")
        return
    end if
    self.sick = false
    self.energy = clamp(self.energy - 5, 0, 100)
    self.hunger = clamp(self.hunger - 20, 0, 100)
    print(self.name + " takes the medicine and makes a funny face. Feeling better!")
end function

// ---------- generations ----------
Brain.Legacy = function()
    if self.age < 150 or self.bond < 50 then
        print(self.name + " must be at least a teen (age 150) with bond 50+ to start a legacy.")
        return
    end if
    ans = user_input("Retire " + self.name + " and hatch its child? It keeps 3 words and half its mind. (y/n) ").lower
    if ans != "y" then return
    old = self.name
    self.curious = clamp(self.curious + rnd * 0.3 - 0.15, 0.05, 1)
    self.brave = clamp(self.brave + rnd * 0.3 - 0.15, 0.05, 1)
    self.social = clamp(self.social + rnd * 0.3 - 0.15, 0.05, 1)
    kept = []
    for w in self.words
        if kept.len < 3 then kept.push(w)
    end for
    self.words = kept
    for j in range(0, K - 1)
        self.hb[j] = self.hb[j] * 0.5
        for i in range(0, INW - 1)
            self.hw[j][i] = self.hw[j][i] * 0.5
        end for
    end for
    for w in self.sent.indexes
        self.sent[w] = self.sent[w] * 0.5
    end for
    self.gen = self.gen + 1
    self.name = makeName()
    UI.name = self.name
    self.age = 0
    self.stageName = "baby"
    self.hunger = 0
    self.boredom = 0
    self.energy = 100
    self.stress = 0
    self.happy = 0.7
    self.bond = 20
    self.sick = false
    self.bpm = 70
    self.equipped = ""
    self.diary = []
    self.Note("born to " + old + " (generation " + self.gen + ")")
    self.Hatch(true)
end function

