end function

// ---------- speech ----------
Brain.Garble = function(w, amount)
    out = ""
    for ch in w
        if rnd < amount then
            out = out + randLetter(alphabet)
        else
            out = out + ch
        end if
    end for
    return out
end function

Brain.Babble = function(mood)
    trust = clamp(self.bgTotal / 250, 0, 0.85)
    nw = 1 + floor(rnd * 2 + mood * 2 * self.Scale())
    list1 = []
    vowelChance = 0.25 + mood * 0.35
    for i in range(1, nw)
        if rnd < trust then
            list1.push(self.BigramWord(3 + floor(rnd * 5 * self.Scale()) + 1))
        else
            sz = floor((2 + mood * 5 + rnd * 3) * self.Scale())
            if sz < 2 then sz = 2
            w = ""
            for k in range(1, sz)
                if rnd < vowelChance then
                    w = w + randLetter(vowels)
                else
                    w = w + randLetter(consonants)
                end if
            end for
            list1.push(w)
        end if
    end for
    msg = list1.join(" ")
    if self.words.len > 0 and self.Stage() != "baby" and rnd < 0.4 then
        lw = self.words[floor(rnd * self.words.len)]
        fog = (100 - self.energy) / 200
        if self.sick then fog = fog + 0.15
        msg = msg + " " + self.Garble(lw, fog)
    end if
    if mood > 0.7 then
        msg = msg + "!"
    else if mood < 0.3 then
        msg = msg + "..."
    else
        msg = msg + "."
    end if
    return msg
end function

Brain.Speak = function()
    if self.energy <= 0 then
        print(self.name + " is too tired... zzz (try 'feed' or 'sleep')")
        return
    end if
    mood = self.Mood()
    print(self.Tag() + " " + self.Face(mood) + ": " + self.Babble(mood) + "   [" + self.MoodName(mood) + ", " + round(self.bpm) + " bpm]")
    self.energy = clamp(self.energy - 3, 0, 100)
    self.boredom = clamp(self.boredom - 8, 0, 100)
end function

Brain.Sing = function()
    if self.energy < 10 then
        print(self.name + " is too tired to sing.")
        return
    end if
    print(self.Tag() + " starts to sing, keeping time with its heart:")
    for i in range(1, 6)
        syl = randLetter(consonants) + randLetter(vowels)
        if self.bgTotal > 40 and rnd < 0.5 then syl = self.BigramWord(4)
        print("  <color=#ffcc44>" + syl + "</color> " + ("*" * (1 + floor(rnd * 4))) + "  " + round(self.bpm) + " bpm")
        pause(60 / self.bpm)
        self.bpm = clamp(self.bpm + 1, 40, 200)
    end for
    print(self.name + " takes a bow.")
