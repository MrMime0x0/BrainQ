UI.pad = function(s, n)
    if s.len >= n then return s
    return s + " " * (n - s.len)
end function

UI.ltrim = function(s)
    while s.len > 0 and s[0] == " "
        s = s[1:]
    end while
    return s
end function

// removes rich-text tags like <color=#fff> but keeps things like "<3"
UI.strip = function(s)
    if s.len == 0 then return ""
    out = ""
    skip = false
    for i in range(0, s.len - 1)
        ch = s[i]
        if skip then
            if ch == ">" then skip = false
        else if ch == "<" and i + 1 < s.len and ("abcdefghijklmnopqrstuvwxyz/").indexOf(s[i + 1]) != null then
            skip = true
        else
            out = out + ch
        end if
    end for
    return out
end function

UI.wrap = function(s, w)
    lines = []
    cur = ""
    for word in s.split(" ")
        if word == "" then continue
        while word.len > w
            if cur != "" then
                lines.push(cur)
                cur = ""
            end if
            lines.push(word[:w])
            word = word[w:]
        end while
        if cur == "" then
            cur = word
        else if cur.len + 1 + word.len <= w then
            cur = cur + " " + word
        else
            lines.push(cur)
            cur = word
        end if
    end for
    if cur != "" then lines.push(cur)
    if lines.len == 0 then lines.push("")
    return lines
end function

// print one line, remember it for 'cls' redraws
UI.emit = function(s, rep)
    UI.log.push(s)
    if UI.log.len > 80 then UI.log.remove(0)
    if rep then
        rawPrint(s, true)
    else
        rawPrint(s)
    end if
end function

UI.faceColor = function(face)
    t = UI.t
    if face.indexOf("^") != null then return t["good"]
    if face.indexOf("x_x") != null or face.indexOf("O_O") != null then return t["bad"]
    if face.indexOf(";") != null or face.indexOf("._.") != null then return t["info"]
    if face.indexOf("-_-") != null then return t["dim"]
    return t["acc"]
end function

// ---- chat bubble ----
UI.bubble = function(label, lcol, body, meta, side, bg, fg, withTyping)
    t = UI.t
    lines = UI.wrap(body, UI.width)
    inner = label.len
    for l in lines
        if l.len > inner then inner = l.len
    end for
    if meta.len > inner then inner = meta.len
    ind = "  "
    if side == "right" then
        n = UI.screenW - inner - 4
        if n < 0 then n = 0
        ind = " " * n
    end if
    rows = []
    if UI.mode == "bubbles" then
        rows.push(ind + "<mark=" + bg + "cc> <color=" + lcol + "><b>" + UI.pad(label, inner) + "</b></color> </mark>")
        for l in lines
            rows.push(ind + "<mark=" + bg + "cc> <color=" + fg + ">" + UI.pad(l, inner) + "</color> </mark>")
        end for
        if meta != "" then rows.push(ind + "<mark=" + bg + "cc> <color=" + t["dim"] + ">" + UI.pad(meta, inner) + "</color> </mark>")
    else
        rows.push(ind + "<color=" + lcol + "><b>" + label + "</b></color>")
        for l in lines
            rows.push(ind + "<color=" + fg + ">  " + l + "</color>")
        end for
        if meta != "" then rows.push(ind + "<color=" + t["dim"] + ">  " + meta + "</color>")
    end if
    typed = false
    if withTyping and UI.typing and UI.on then
        rawPrint(ind + "<color=" + t["dim"] + "><i>" + label + " is typing...</i></color>")
        wait(0.35 * speedMul)
        typed = true
    end if
    for i in range(0, rows.len - 1)
        UI.emit(rows[i], typed and i == 0)
    end for
end function

UI.banner = function(txt, col)
