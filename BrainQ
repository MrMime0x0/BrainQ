Brain.Mind = function()
    print("--- " + self.name + "'s mind ---")
    acc = "n/a"
    if self.guesses > 0 then acc = round(self.hits / self.guesses * 100) + "%"
    print("1) habit model: " + self.mlSteps + " observations, guessed right " + self.hits + "/" + self.guesses + " (" + acc + ")")
    p = self.Predict()
    items = []
    for j in range(0, K - 1)
        items.push({"name": cmds[j], "v": p[j]})
    end for
    items.sort("v")
    print("   expects you to do next:")
    for i in range(1, 3)
        it = items[items.len - i]
        print("   " + it.name + " " + self.Bar(it.v * 100) + " " + round(it.v * 100) + "%")
    end for
    print("2) feelings model: " + self.sent.len + " words judged")
    if self.sent.len > 0 then
        fl = []
        for w in self.sent.indexes
            fl.push({"name": w, "v": self.sent[w]})
        end for
        fl.sort("v")
        low = fl[0]
        high = fl[fl.len - 1]
        if low.v < 0 then print("   dislikes most: <color=#ff8844>" + low.name + "</color> " + round(low.v, 2))
        if high.v > 0 then print("   likes most   : <color=#44ff44>" + high.name + "</color> +" + round(high.v, 2))
    end if
    print("3) letter model: " + self.bgTotal + " letters studied, language trust " + round(clamp(self.bgTotal / 250, 0, 0.85) * 100) + "%")
    if self.bg.len > 0 then
        bl = []
        for k in self.bg.indexes
            bl.push({"name": k, "v": self.bg[k]})
        end for
        bl.sort("v")
        out = []
        for i in range(1, 5)
            if bl.len - i >= 0 then out.push(bl[bl.len - i].name + "(" + bl[bl.len - i].v + ")")
        end for
        print("   favourite letter pairs (^ start, $ end): " + out.join("  "))
    end if
    print("4) rock-paper-scissors: you won " + self.rpsWins + " rounds, it won " + self.rpsLoss)
    print("   sample babble from the letter model: " + self.BigramWord(8))
end function

Brain.Diary = function()
    if self.diary.len == 0 then
        print("The diary is empty.")
        return
    end if
    print("--- " + self.name + "'s diary ---")
    for line in self.diary
        print("  " + line)
    end for
end function

Brain.Achievements = function()
    print("--- achievements " + self.ach.len + "/" + achTitles.len + " ---")
