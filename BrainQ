// ---------- XOR core ----------
Brain.Think = function(inputs)
    h = []
    for n in self.hidden
        h.push(n.Think(inputs))
    end for
    self.hOut = h
    return self.output.Think(h)
end function

Brain.Learn = function(inputs, target, rate)
    out = self.Think(inputs)
    self.output.delta = (target - out) * out * (1 - out)
    for i in range(0, self.hidden.len - 1)
        n = self.hidden[i]
        n.delta = self.output.delta * self.output.w[i] * n.out * (1 - n.out)
    end for
    for i in range(0, self.output.w.len - 1)
        self.output.w[i] = self.output.w[i] + rate * self.output.delta * self.hOut[i]
    end for
    self.output.bias = self.output.bias + rate * self.output.delta
    for n in self.hidden
        for i in range(0, 1)
            n.w[i] = n.w[i] + rate * n.delta * inputs[i]
        end for
        n.bias = n.bias + rate * n.delta
    end for
end function

// ---------- diary, xp, coins, achievements, quests ----------
Brain.Day = function()
    return floor(self.age / 24) + 1
end function

Brain.Hour = function()
    return self.age % 24
end function

Brain.Phase = function()
    h = self.Hour()
    if h >= 22 or h < 6 then return "night"
    if h < 12 then return "morning"
    if h < 18 then return "day"
    return "evening"
end function

Brain.Note = function(text)
    self.diary.push("day " + self.Day() + ", " + self.Hour() + "h: " + text)
    if self.diary.len > 15 then self.diary.remove(0)
end function

Brain.Tag = function()
    if self.equipped == "" then return self.name
    return self.name + "[" + self.equipped + "]"
end function

Brain.Gain = function(n)
    self.xp = self.xp + n
    while self.xp >= self.level * 40
        self.xp = self.xp - self.level * 40
        self.level = self.level + 1
        self.coins = self.coins + 10
        print("<color=#ffff44>*** LEVEL UP! " + self.name + " is now level " + self.level + " (+10 coins) ***</color>")
        self.Note("reached level " + self.level)
    end while
end function

Brain.Unlock = function(id, cond)
    if not cond then return
    if self.ach.indexOf(id) != null then return
    self.ach.push(id)
    self.coins = self.coins + 10
    print("<color=#ffaa00>ACHIEVEMENT: " + achTitles[id] + " (+10 coins)</color>")
    self.Note("achievement: " + achTitles[id])
end function

Brain.CheckAch = function()
    self.Unlock("word", self.words.len >= 1)
    self.Unlock("smith", self.words.len >= 8)
    self.Unlock("friend", self.bond >= 90)
    self.Unlock("faint", self.faints >= 1)
    self.Unlock("rich", self.coins >= 100)
    self.Unlock("reader", self.hits >= 10)
    self.Unlock("gamer", self.gamesPlayed >= 6)
    self.Unlock("hacker", self.hacks >= 3)
    self.Unlock("adult", self.age >= 150)
    self.Unlock("lvl5", self.level >= 5)
    self.Unlock("social", self.friends.len >= 3)
    self.Unlock("poet", self.invented >= 1)
    self.Unlock("dynasty", self.gen >= 2)
end function

Brain.NewQuest = function()
    opts = [["feed",2,10], ["pet",3,10], ["play",1,15], ["say",3,12], ["learn",1,20], ["sleep",1,15], ["sing",1,12], ["talk",2,8], ["game",2,18]]
