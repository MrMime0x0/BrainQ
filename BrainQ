// ---------- helpers ----------
pause = function(t)
    wait(t * speedMul)
end function

sigmoid = function(x)
    return 1 / (1 + 2.718281828 ^ (-x))
end function

randLetter = function(pool)
    return pool[floor(rnd * pool.len)]
end function

clamp = function(v, lo, hi)
    if v < lo then return lo
    if v > hi then return hi
    return v
end function

randomWord = function(size, pool)
    s = ""
    for i in range(1, size)
        s = s + randLetter(pool)
    end for
    return s
end function

isWord = function(w)
    if w.len == 0 then return false
    for ch in w
        if alphabet.indexOf(ch) == null then return false
    end for
    return true
end function

makeName = function()
    n = ""
    size = 4 + floor(rnd * 3)
    for i in range(1, size)
        if i % 2 == 1 then
            n = n + randLetter(consonants)
        else
            n = n + randLetter(vowels)
        end if
    end for
    return n[0].upper + n[1:]
end function

bump = function(m, k, n)
    if m.hasIndex(k) then
        m[k] = m[k] + n
    else
        m[k] = n
    end if
end function

scrambleWord = function(w)
    best = w
    for attempt in range(1, 10)
        letters = []
        for ch in w
            letters.push(ch)
        end for
        for i in range(letters.len - 1, 1)
            j = floor(rnd * (i + 1))
            t = letters[i]
            letters[i] = letters[j]
            letters[j] = t
        end for
        best = letters.join("")
        if best != w then return best
    end for
    return best
end function

dumpMap = function(m)
    out = []
    for k in m.indexes
        out.push(k + ":" + round(m[k], 3))
    end for
    return out.join("|")
end function

parseMap = function(s)
    m = {}
    if s == "" then return m
    for pair in s.split("|")
        kv = pair.split(":")
        if kv.len == 2 then m[kv[0]] = kv[1].val
    end for
    return m
end function

getNum = function(d, key, dflt)
    if d.hasIndex(key) and d[key] != "" then return d[key].val
    return dflt
end function

getStr = function(d, key, dflt)
    if d.hasIndex(key) then return d[key]
    return dflt
end function

getList = function(d, key)
    if d.hasIndex(key) and d[key] != "" then return d[key].split("|")
    return []
end function

