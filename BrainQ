// ---------- Neuron ----------
Neuron = {}
Neuron.New = function(inputCount)
    n = new Neuron
    n.w = []
    for i in range(1, inputCount)
        n.w.push(rnd * 2 - 1)
    end for
    n.bias = rnd * 2 - 1
    n.out = 0
    n.delta = 0
    return n
end function

Neuron.Think = function(inputs)
    sum = self.bias
    for i in range(0, inputs.len - 1)
        sum = sum + self.w[i] * inputs[i]
    end for
    self.out = sigmoid(sum)
    return self.out
end function

