end function

// ---- a line spoken by the brain ----
UI.brainLine = function(lt)
    t = UI.t
    nm = UI.name
    rest = lt[nm.len:]
    label = nm
    if rest.len > 0 and rest[0] == "[" then
        e = rest.indexOf("]")
        if e != null then
            label = label + " " + rest[:e + 1]
            rest = rest[e + 1:]
        end if
    end if
    rest = UI.ltrim(rest)
    speech = (rest.indexOf(":") != null) or (rest.indexOf("listens...") != null)
    if not speech then
        UI.emit("  <color=" + t["dim"] + "><i>* " + lt + " *</i></color>", false)
        return
    end if
    face = ""
    if rest.len > 0 and rest[0] == "(" then
        e = rest.indexOf(")")
        if e != null then
            face = rest[:e + 1]
            rest = rest[e + 1:]
            if rest.len >= 3 and rest[:3] == "zzz" then
                face = face + "zzz"
                rest = rest[3:]
            end if
        end if
    end if
    rest = UI.ltrim(rest)
    if rest.len > 0 and rest[0] == ":" then rest = UI.ltrim(rest[1:])
    meta = ""
    m = rest.indexOf("   [")
    if m != null then
        meta = rest[m + 3:]
        rest = rest[:m]
    end if
    if rest == "" then rest = "..."
    lcol = UI.faceColor(face)
    UI.bubble(label + " " + face, lcol, rest, meta, "left", t["bot"], t["botFg"], true)
end function

// ---- decide how each printed line should look ----
UI.route = function(s)
    t = UI.t
    plain = UI.strip(s)
    lt = UI.ltrim(plain)
    if lt == "" then
        UI.emit("", false)
        return
    end if
    if lt[:3] == "---" then
        UI.title(lt)
        return
    end if
    if plain.indexOf("FAINTS") != null or plain.indexOf("TRACE DETECTED") != null then
        UI.banner(lt, t["bad"])
        return
    end if
    if plain.indexOf("LEVEL UP") != null or plain.indexOf("ACHIEVEMENT") != null or plain.indexOf("QUEST COMPLETE") != null then
        UI.banner(lt, t["warn"])
        return
    end if
    if plain.indexOf("has grown into") != null or plain.indexOf(" is born!") != null then
        UI.banner(lt, t["good"])
        return
    end if
    if lt.len > 4 and (lt[:4] == "gen " or lt[:4] == "try ") then
        UI.emit("  <color=#3fae5a>$ " + lt + "</color>", false)
        return
    end if
    ai = plain.indexOf(" answers: ")
    if ai != null then
        UI.bubble(plain[:ai], t["warn"], plain[ai + 10:], "visitor", "left", t["bot"], t["botFg"], true)
        return
    end if
    nm = UI.name
    if nm != "" and lt.len > nm.len and lt[:nm.len] == nm then
        UI.brainLine(lt)
        return
    end if
    if lt[0] == "(" then
        UI.emit("  <i>" + s + "</i>", false)
        return
    end if
    UI.emit("<color=" + t["acc"] + ">|</color> " + s, false)
end function

// ---- replace print with the graphics router ----
print = function(s, rep)
    if not UI.on then
        rawPrint(s)
        return
    end if
    UI.route(str(s))
end function

